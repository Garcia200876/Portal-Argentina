@{
    ViewData["Title"] = "Esportes";
}

<section class="hero-esporte">

    <div class="overlay-esporte">

        <div class="container">

            <div class="row align-items-center vh-100">

                <div class="col-lg-8">

                    <h1 class="titulo">

                        Esportes na Argentina

                    </h1>

                    <p class="descricao">

                        O esporte faz parte da identidade argentina.
                        Conheça suas modalidades mais populares,
                        seus maiores atletas e as principais conquistas internacionais.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>
<section class="container py-5">

    <h2 class="text-center mb-5">

        Principais Esportes

    </h2>

    <div class="row">

        <div class="col-md-4">

            <div class="card shadow h-100">

                <img src="~/images/esporte/futebol.jpg" class="card-img-top" alt="Futebol">

                <div class="card-body">

                    <h4>Futebol</h4>

                    <p>O esporte mais popular do país, com três títulos da Copa do Mundo (1978, 1986 e 2022).</p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow h-100">

                <img src="~/images/esporte/rugby.jpg" class="card-img-top" alt="Rugby">

                <div class="card-body">

                    <h4>Rugby</h4>

                    <p>Os Pumas representam a Argentina entre as principais seleções do mundo.</p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow h-100">

                <img src="~/images/esporte/basquete.jpg" class="card-img-top" alt="Basquete">

                <div class="card-body">

                    <h4>Basquete</h4>

                    <p>A seleção conquistou a medalha de ouro nos Jogos Olímpicos de Atenas em 2004.</p>

                </div>

            </div>

        </div>

    </div>

</section>
<section class="container py-5">

    <h2 class="text-center mb-5">

        Copas do Mundo

    </h2>

    <div class="row text-center">

        <div class="col-md-4">

            <h3>1978</h3>

            <p>Primeiro título mundial, conquistado em casa.</p>

        </div>

        <div class="col-md-4">

            <h3>1986</h3>

            <p>Conquista liderada por Diego Maradona no México.</p>

        </div>

        <div class="col-md-4">

            <h3>2022</h3>

            <p>Título conquistado no Catar com Lionel Messi como capitão.</p>

        </div>

    </div>

</section>
<section class="container py-5">

    <h2 class="text-center mb-5">

        Grandes Ídolos do Esporte Argentino

    </h2>

    <div class="row">

        <div class="col-md-4 text-center">

            <img src="~/images/esporte/messi.jpg"
                 class="img-fluid rounded-circle shadow mb-3"
                 style="width:220px;height:220px;object-fit:cover;">

            <h4>Lionel Messi</h4>

        </div>

        <div class="col-md-4 text-center">

            <img src="~/images/esporte/ginobili.jpg"
                 class="img-fluid rounded-circle shadow mb-3"
                 style="width:220px;height:220px;object-fit:cover;">

            <h4>Manu Ginóbili</h4>

        </div>

        <div class="col-md-4 text-center">

            <img src="~/images/esporte/fangio.jpg"
                 class="img-fluid rounded-circle shadow mb-3"
                 style="width:220px;height:220px;object-fit:cover;">

            <h4>Juan Manuel Fangio</h4>

        </div>

    </div>

</section>