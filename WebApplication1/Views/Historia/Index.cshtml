@{
    ViewData["Title"] = "História";
}

<section class="hero-historia">

    <div class="overlay-historia">

        <div class="container">

            <div class="row align-items-center vh-100">

                <div class="col-lg-8">

                    <h1 class="titulo">

                        História da Argentina

                    </h1>

                    <p class="descricao">

                        Conheça os principais acontecimentos que marcaram
                        a formação da Argentina, desde a Revolução de Maio
                        até a consolidação da democracia.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="historia-conteudo py-5">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <h2>A Independência da Argentina</h2>

                <p>
                    A independência da Argentina foi declarada em
                    <strong>9 de julho de 1816</strong>, durante o Congresso de Tucumán.
                    Esse momento marcou oficialmente o rompimento com a Coroa Espanhola
                    e deu início à formação do país como uma nação soberana.
                </p>

                <p>
                    O processo de independência foi influenciado pela Revolução de Maio
                    de 1810 e pelos movimentos de emancipação que ocorreram em diversos
                    países da América do Sul.
                </p>

            </div>

            <div class="col-lg-6">

                <img src="~/images/historia/independencia.jpg"
                     class="img-fluid rounded shadow"
                     alt="Casa Histórica de Tucumán">

            </div>

        </div>

    </div>

</section>