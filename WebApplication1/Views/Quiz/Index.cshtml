@model List<PortalArgentina.Models.PerguntaQuiz>

@{
    ViewData["Title"] = "Quiz Argentina";
}

<section class="quiz-banner">
    <div class="container text-center">
        <span class="eyebrow eyebrow-light">CLUBE ARGENTINA</span>
        <h1>Quiz da Argentina 🇦🇷</h1>
        <p>São 10 perguntas. Acerte o máximo que puder e coloque seu nome no ranking.</p>
    </div>
</section>

<div class="container py-5">
    <form asp-action="Corrigir" asp-controller="Quiz" method="post">
        @Html.AntiForgeryToken()
        @for (int p = 0; p < Model.Count; p++)
        {
            <div class="quiz-card mb-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <span class="badge text-bg-primary rounded-pill">Questão @(p + 1)</span>
                    <span class="text-muted small">@Model[p].Alternativas.Count alternativas</span>
                </div>
                <h3>@Model[p].Pergunta</h3>
                <div class="mt-3">
                    @for (int a = 0; a < Model[p].Alternativas.Count; a++)
                    {
                        <label class="quiz-option">
                            <input class="form-check-input" type="radio" name="respostas[@p]" value="@a" required />
                            @Model[p].Alternativas[a]
                        </label>
                    }
                </div>
            </div>
        }

        <div class="text-center py-3">
            <button type="submit" class="btn btn-warning btn-lg rounded-pill px-5 fw-bold">Finalizar quiz</button>
        </div>
    </form>
</div>
