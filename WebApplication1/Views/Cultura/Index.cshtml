@{
    ViewData["Title"] = "Cultura";
}

<section class="hero-cultura">

    <div class="overlay-cultura">

        <div class="container">

            <div class="row align-items-center vh-100">

                <div class="col-lg-7">

                    <h1 class="titulo">

                        Cultura Argentina

                    </h1>

                    <p class="descricao">

                        Descubra as tradições, a música, o tango, o mate e os costumes
                        que fazem da Argentina um dos países culturalmente mais ricos da América do Sul.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>
<section class="container py-5">

    <div class="row">

        <div class="col-lg-6">

            <h2>A Cultura Argentina</h2>

            <p>

                A cultura argentina é resultado da influência dos povos indígenas,
                da colonização espanhola e da forte imigração europeia,
                principalmente italiana e espanhola.

            </p>

            <p>

                O país é conhecido mundialmente pelo tango, pelo chimarrão
                (mate), pela gastronomia e por seus grandes escritores.

            </p>

        </div>

        <div class="col-lg-6">

            <img src="~/images/cultura/mate.jpg"
                 class="img-fluid rounded shadow">

        </div>

    </div>

</section>
<section class="container py-5">

    <h2 class="text-center mb-5">

        Tradições Argentinas

    </h2>

    <div class="row">

        <div class="col-md-4">

            <div class="card shadow">

                <img src="~/images/cultura/mate.jpg" class="card-img-top">

                <div class="card-body">

                    <h4>Mate</h4>

                    <p>A bebida mais tradicional da Argentina.</p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow">

                <img src="~/images/cultura/folclore.jpg" class="card-img-top">

                <div class="card-body">

                    <h4>Folclore</h4>

                    <p>Danças e músicas tradicionais presentes em todo o país.</p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow">

                <img src="~/images/cultura/empanadas.jpg" class="card-img-top">

                <div class="card-body">

                    <h4>Gastronomia</h4>

                    <p>Empanadas, asado e doces tradicionais fazem parte da cultura.</p>

                </div>

            </div>

        </div>

    </div>

</section>